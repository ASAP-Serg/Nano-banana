# Written automatically on Deploy VPS from GitHub Secrets (ASAP-Serg/Nano-banana):
#   SALARIS_API_KEY
#   SALARIS_MOSAICA_EMAIL
#   SALARIS_MOSAICA_PASSWORD
#   SALARIS_GOOGLE_SHEETS_CREDENTIALS   (JSON one line, same SA as Statistics bot)
#
# gh secret set SALARIS_API_KEY -R ASAP-Serg/Nano-banana
# gh secret set SALARIS_MOSAICA_EMAIL -R ASAP-Serg/Nano-banana
# gh secret set SALARIS_MOSAICA_PASSWORD -R ASAP-Serg/Nano-banana
# gh secret set SALARIS_GOOGLE_SHEETS_CREDENTIALS -R ASAP-Serg/Nano-banana < sheets.json
#
# In Google Sheet Script properties:
#   SERVER_URL = https://ooneclickk.ru/salaris
#   (API key for the button comes from GET /sheets-config → same SALARIS_API_KEY)

API_KEY=change-me
PROCESS_API_URL=https://ooneclickk.ru/salaris
PORT=5000
DEBUG=False
HEADLESS=false
CHROME_USER_DATA_DIR=/data/chrome-user-data
MOSAICA_EMAIL=
MOSAICA_PASSWORD=
GOOGLE_SHEETS_CREDENTIALS=
