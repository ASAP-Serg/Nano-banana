# Сервер: только второй этап (Salaris / Selenium). BigQuery не используется.
API_KEY=your-api-key
PROCESS_API_URL=http://127.0.0.1:5000
PORT=5000
DEBUG=False

# Mosaica (для проставления статусов)
MOSAICA_EMAIL=your-email@example.com
MOSAICA_PASSWORD=your-password

# Без headless Google реже блокирует (как в Bot-otchet). На сервере: Xvfb :99 & export DISPLAY=:99, затем HEADLESS=false
# HEADLESS=false
# Размер виртуального экрана Xvfb и окна Chrome (для VNC)
# DISPLAY_WIDTH=1920
# DISPLAY_HEIGHT=1080
# DISPLAY_DEPTH=24

# Постоянный профиль Chrome (рекомендуется для обхода постоянной капчи Google):
# 1) Один раз запусти с HEADLESS=false, зайди в аккаунт вручную через VNC и пройди капчу/2FA.
# 2) Дальше Selenium будет использовать сохраненную сессию.
# CHROME_USER_DATA_DIR=/data/chrome-user-data
# CHROME_PROFILE_DIRECTORY=Default

# Креды бота для Google Таблиц (POST /process-from-sheet).
# Вариант 1 — путь к файлу: GOOGLE_SHEETS_CREDENTIALS=/app/sheets-credentials.json
# Вариант 2 — JSON одной строкой (в .env оберни в ОДИНАРНЫЕ кавычки, чтобы не ломало парсер):
#   GOOGLE_SHEETS_CREDENTIALS='{"type":"service_account","project_id":"...","private_key":"-----BEGIN...\n...\n-----END...\n",...}'
# Вариант 3 — base64 (удобно, одна строка без кавычек): положи JSON в файл, затем:
#   echo -n "$(cat sheets.json)" | base64 -w0  и вставь в GOOGLE_SHEETS_CREDENTIALS_B64=...
# Таблицу расшарь на client_email из ключа.
