# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nano_banana
POSTGRES_USER=nano_banana_user
POSTGRES_PASSWORD=change-me

# Redis (очередь worker)
REDIS_URL=redis://redis:6379/0

# Object storage (MinIO локально, Yandex Object Storage в проде)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=nano-banana-images
MINIO_USE_SSL=false
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000
S3_PUBLIC_READ=true

# JWT можно ротировать. Шифрование ключей пользователей — отдельный ключ.
SECRET_KEY=change-me-jwt-secret-min-32-characters-long
# На уже живом Beget можно оставить пустым: расшифровка пойдёт через SECRET_KEY.
DATA_ENCRYPTION_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180
REFRESH_TOKEN_EXPIRE_DAYS=7

# Public URLs
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8000

# Moonez
BANANALAB_API_BASE_URL=https://api.moonez.ai/api
BANANALAB_BASE_URL=https://api.moonez.ai/api
BANANALAB_UPSTREAM_NO_IMAGE_MAX_RETRIES=5
BANANALAB_UPSTREAM_NO_IMAGE_RETRY_BASE_DELAY_SECONDS=3

# OpenRouter (опционально)
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=Nano Banana
OPENROUTER_PROMPT_REWRITE_MODEL=openai/gpt-4o-mini
MAX_POLICY_GPT_RETRIES=2

MAX_WORKERS=1
MAX_CONCURRENT_GENERATIONS=1

SECURITY_STRICT_CSP=true
SECURITY_ENABLE_HSTS=true
SECURITY_DISABLE_OPENAPI=false
SECURITY_CSP_ALLOW_INLINE_SCRIPTS=true
SECURITY_LOGIN_MAX_ATTEMPTS=10
SECURITY_LOGIN_WINDOW_SECONDS=300
SECURITY_REGISTER_MAX_ATTEMPTS=10
SECURITY_REGISTER_WINDOW_SECONDS=3600
SECURITY_ALLOWED_REF_URL_HOSTS=
